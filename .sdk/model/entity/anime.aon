# Entity: anime

main: kit: entity: anime: {

  alias: field: {}

  fields: [
    {
      name: "Genre"
      req: true
      short: "Genre as string or array of strings"
      type: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    {
      name: "Name"
      req: true
      short: "Anime name to match"
      type: "`$STRING`"
    }
    {
      name: "exists"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "anime"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/check"
          parts: [
            "api"
            "check"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/getAll"
          parts: [
            "api"
            "getAll"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/getlast"
          parts: [
            "api"
            "getlast"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
