# Entity: find

main: kit: entity: find: {

  alias: field: {}

  fields: {
    ep: {
      h: "Ep"
      n: "ep"
      r: false
      sh: "Episode count if found"
      t: "`$INTEGER`"
    }
    exist: {
      h: "Exist"
      n: "exist"
      r: true
      sh: "Whether anime exists"
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Anime ID if found"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "find"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/find/{name}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "One Piece"
                k: "param"
                n: "id"
                or: "name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/find/{name}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              name: "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "find"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
