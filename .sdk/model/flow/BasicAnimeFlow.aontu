# BasicAnimeFlow

main: kit: flow: BasicAnimeFlow:
{
  entity: "anime",
  kind: "basic",
  name: "BasicAnimeFlow",
  step: [
    {
      i: {
        ref: "anime_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "anime_ref01",
        srcdatavar: "anime_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-anime_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAnimeFlow"
}